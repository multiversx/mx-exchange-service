# Environment for the public edge test harness (test/edge).
# Loaded before any application module, overriding the shell and .env files.
NODE_ENV=test
NODE_CONFIG_DIR="src/config"
LOG_LEVEL=error
LOG_FILE=

REDIS_URL="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

ENABLE_PLAYGROUND=false
ENABLE_COMPLEXITY=true

GUEST_CACHE_REDIS_BATCH_SIZE=3
