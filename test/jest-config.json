{
    "moduleFileExtensions": ["js", "json", "ts"],
    "modulePaths": ["<rootDir>"],
    "rootDir": "../",
    "testRegex": "src/.*spec.ts$",
    "testEnvironment": "node",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "setupFiles": ["<rootDir>/test/jest.setup.ts"],
    "coverageDirectory": "./coverage/unit"
}
