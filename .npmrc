auto-install-peers=true
strict-peer-dependencies=false

# Refuse to install any package version published less than 2 days ago.
# Mitigates supply-chain attacks: most compromised releases are detected and
# unpublished within hours, so a short quarantine window catches them before
# they ever land in node_modules. Already-locked versions in pnpm-lock.yaml
# are unaffected — this only gates resolutions of *new* / updated deps.
minimum-release-age=2880
