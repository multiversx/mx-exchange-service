{
    "name": "dex-service",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.33.4",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "pnpm copy-env && TZ=UTC nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "copy-env": "cp .env.example .env",
        "test": "node --expose-gc --no-compilation-cache ./node_modules/jest/bin/jest.js --logHeapUsage --config ./test/jest-config.json --forceExit --logHeapUsage --maxWorkers=2",
        "test:watch": "jest --watch",
        "test:cov": "node --expose-gc --no-compilation-cache ./node_modules/jest/bin/jest.js --silent --verbose false --coverage --config ./test/jest-config.json --forceExit --logHeapUsage --maxWorkers=2",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "ts-node ./node_modules/typeorm/cli",
        "typeorm:run-migrations": "pnpm typeorm migration:run -- -d ./src/services/analytics/timescaledb/migration/typeOrm.config.ts",
        "typeorm:generate-migration": "pnpm typeorm -- -d ./src/services/analytics/timescaledb/migration/typeOrm.config.ts migration:generate ./src/services/analytics/timescaledb/migration/xExchange",
        "typeorm:create-migration": "pnpm typeorm -- migration:create ./src/services/analytics/timescaledb/migration/xExchange",
        "typeorm:revert-migration": "pnpm typeorm -- -d ./src/services/analytics/timescaledb/migration/typeOrm.config.ts migration:revert"
    },
    "dependencies": {
        "@apollo/gateway": "^2.5.4",
        "@apollo/server": "^4.9.1",
        "@datastructures-js/priority-queue": "^6.1.0",
        "@elastic/elasticsearch": "^7.17.14",
        "@golevelup/nestjs-rabbitmq": "^4.0.0",
        "@grpc/grpc-js": "^1.14.1",
        "@grpc/proto-loader": "^0.8.0",
        "@grpc/reflection": "^1.0.4",
        "@isaacs/ttlcache": "^1.4.1",
        "@multiversx/sdk-core": "^13.15.3",
        "@multiversx/sdk-exchange": "^0.2.24",
        "@multiversx/sdk-native-auth-server": "1.0.19",
        "@multiversx/sdk-nestjs-cache": "^4.2.0",
        "@multiversx/sdk-nestjs-common": "^4.2.0",
        "@multiversx/sdk-nestjs-elastic": "^4.2.0",
        "@multiversx/sdk-nestjs-http": "^4.2.0",
        "@multiversx/sdk-nestjs-monitoring": "^4.2.0",
        "@multiversx/sdk-network-providers": "^2.0.0",
        "@nestjs/apollo": "^12.0.7",
        "@nestjs/axios": "^3.0.0",
        "@nestjs/cache-manager": "^3.1.2",
        "@nestjs/common": "^10.2.0",
        "@nestjs/config": "^3.0.0",
        "@nestjs/core": "^10.2.0",
        "@nestjs/graphql": "^12.0.8",
        "@nestjs/microservices": "^10.2.0",
        "@nestjs/mongoose": "^10.1.0",
        "@nestjs/platform-express": "^10.2.0",
        "@nestjs/schedule": "^3.0.2",
        "@nestjs/typeorm": "^10.0.0",
        "agentkeepalive": "^4.2.1",
        "axios": "^1.3.1",
        "bignumber.js": "9.0.1",
        "cache-manager": "^7.2.8",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "config": "^3.3.7",
        "cookie-parser": "^1.4.6",
        "crypto-js": "^4.2.0",
        "dataloader": "^2.2.2",
        "dotenv": "^16.4.5",
        "express": "^4.18.1",
        "graphql": "^16.5.0",
        "graphql-query-complexity": "^1.0.0",
        "graphql-redis-subscriptions": "^2.4.2",
        "graphql-relay": "^0.10.1",
        "graphql-subscriptions": "^2.0.0",
        "ioredis": "^5.2.4",
        "jsonwebtoken": "^9.0.0",
        "lru-cache": "^7.14.1",
        "merkletreejs": "^0.3.10",
        "moment": "^2.29.4",
        "mongoose": "^8.24.0",
        "nest-winston": "^1.6.2",
        "pg": "^8.21.0",
        "prom-client": "^14.0.1",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.5.5",
        "typeorm": "^0.3.30",
        "winston": "^3.7.2",
        "winston-transport": "^4.5.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@apollo/protobufjs",
            "@nestjs/core",
            "keccak",
            "protobufjs"
        ]
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/testing": "^10.2.0",
        "@types/crypto-js": "^4.1.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.12.4",
        "@types/supertest": "^7.2.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "jest": "^30.4.2",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.59.4",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.10",
        "ts-node": "^10.8.0",
        "tsconfig-paths": "^3.10.1",
        "typescript": "^5.9.3"
    }
}
