{
    "name": "dex-service",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.33.4",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "pnpm copy-env && TZ=UTC nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "copy-env": "cp .env.example .env",
        "test": "node --expose-gc --no-compilation-cache ./node_modules/jest/bin/jest.js --logHeapUsage --config ./test/jest-config.json --forceExit --logHeapUsage --maxWorkers=2",
        "test:watch": "jest --watch",
        "test:cov": "node --expose-gc --no-compilation-cache ./node_modules/jest/bin/jest.js --silent --verbose false --coverage --config ./test/jest-config.json --forceExit --logHeapUsage --maxWorkers=2",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "ts-node ./node_modules/typeorm/cli",
        "typeorm:run-migrations": "pnpm typeorm migration:run -- -d ./src/services/analytics/timescaledb/migration/typeOrm.config.ts",
        "typeorm:generate-migration": "pnpm typeorm -- -d ./src/services/analytics/timescaledb/migration/typeOrm.config.ts migration:generate ./src/services/analytics/timescaledb/migration/xExchange",
        "typeorm:create-migration": "pnpm typeorm -- migration:create ./src/services/analytics/timescaledb/migration/xExchange",
        "typeorm:revert-migration": "pnpm typeorm -- -d ./src/services/analytics/timescaledb/migration/typeOrm.config.ts migration:revert"
    },
    "dependencies": {
        "@apollo/gateway": "^2.14.0",
        "@apollo/server": "^4.13.0",
        "@datastructures-js/priority-queue": "^6.3.5",
        "@elastic/elasticsearch": "^7.17.14",
        "@golevelup/nestjs-rabbitmq": "^5.7.0",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "@grpc/reflection": "^1.0.4",
        "@isaacs/ttlcache": "^1.4.1",
        "@multiversx/sdk-core": "^15.4.1",
        "@multiversx/sdk-exchange": "^0.2.24",
        "@multiversx/sdk-native-auth-server": "2.1.0",
        "@multiversx/sdk-nestjs-cache": "6.0.1-beta.0",
        "@multiversx/sdk-nestjs-common": "6.0.1-beta.0",
        "@multiversx/sdk-nestjs-elastic": "6.0.1-beta.0",
        "@multiversx/sdk-nestjs-http": "6.0.1-beta.0",
        "@multiversx/sdk-nestjs-monitoring": "6.0.1-beta.0",
        "@multiversx/sdk-nestjs-redis": "6.0.1-beta.0",
        "@nestjs/apollo": "^12.2.2",
        "@nestjs/axios": "^3.1.3",
        "@nestjs/cache-manager": "^3.1.2",
        "@nestjs/common": "^10.4.22",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.22",
        "@nestjs/graphql": "^12.2.2",
        "@nestjs/microservices": "^10.4.22",
        "@nestjs/mongoose": "^10.1.0",
        "@nestjs/platform-express": "^10.4.22",
        "@nestjs/schedule": "^5.0.1",
        "@nestjs/typeorm": "^10.0.2",
        "agentkeepalive": "^4.6.0",
        "axios": "^1.16.1",
        "bignumber.js": "^9.3.1",
        "cache-manager": "^7.2.8",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "config": "^3.3.12",
        "cookie-parser": "^1.4.7",
        "crypto-js": "^4.2.0",
        "dataloader": "^2.2.3",
        "dotenv": "^16.6.1",
        "express": "^4.22.2",
        "graphql": "^16.14.0",
        "graphql-query-complexity": "^1.1.0",
        "graphql-redis-subscriptions": "^2.7.0",
        "graphql-relay": "^0.10.2",
        "graphql-subscriptions": "^2.0.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "lru-cache": "^11.5.0",
        "merkletreejs": "^0.6.0",
        "moment": "^2.30.1",
        "mongoose": "^8.24.0",
        "nest-winston": "^1.10.2",
        "pg": "^8.21.0",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.30",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@apollo/protobufjs",
            "@nestjs/core",
            "keccak",
            "protobufjs"
        ],
        "overrides": {
            "@nestjs/mapped-types": "^2.1.1",
            "@multiversx/sdk-exchange>@multiversx/sdk-core": "^15.4.1"
        }
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/testing": "^10.4.22",
        "@types/crypto-js": "^4.2.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.12.4",
        "@types/supertest": "^7.2.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "jest": "^30.4.2",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^3.15.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.4"
    }
}
